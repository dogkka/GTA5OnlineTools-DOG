<ui:Window
    x:Class="GTA5OnlineTools.Windows.CloudModeNoticeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://crazyzhang.cn/ui/2023/xaml"
    x:Name="Window_CloudNotice"
    Title="云端数据模式 · 使用须知 - DOG"
    Width="600"
    Height="640"
    ResizeMode="NoResize"
    Style="{StaticResource SystemWindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <ui:Window.TitleContent>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <Image
                Height="20"
                Margin="5"
                Source="/Assets/Favicon.ico"
                Style="{StaticResource ImageStyle_HighQuality}" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="Bold"
                Text="云端数据模式 · 使用须知 - DOG" />
        </StackPanel>
    </ui:Window.TitleContent>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            Margin="16,12,16,0"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock
                    FontSize="16"
                    FontWeight="Bold"
                    Text="开启前，请仔细阅读以下内容" />

                <TextBlock
                    Margin="0,12,0,0"
                    FontSize="13.5"
                    FontWeight="Bold"
                    Foreground="#21A366"
                    Text="■ 什么是云端数据模式？" />
                <TextBlock
                    Margin="0,5,0,0"
                    FontSize="13"
                    Foreground="#333333"
                    TextWrapping="Wrap"
                    Text="在「关闭 BattlEye + FSL」的前提下正常进入线上（传承版 / 增强版均适用）。你的存档将照常上传 Rockstar 官方服务器，与其他玩家的数据一样保存在云端（云存档）。" />

                <TextBlock
                    Margin="0,12,0,0"
                    FontSize="13.5"
                    FontWeight="Bold"
                    Foreground="#21A366"
                    Text="■ 与本地数据模式的区别" />
                <TextBlock
                    Margin="0,5,0,0"
                    FontSize="13"
                    Foreground="#333333"
                    TextWrapping="Wrap"
                    Text="· 本地数据模式：存档只保存在本机（%appdata%\FSL），不会上传服务器；&#10;· 云端数据模式：存档实时同步官方服务器，数据与正常游玩一致。" />

                <TextBlock
                    Margin="0,12,0,0"
                    FontSize="13.5"
                    FontWeight="Bold"
                    Foreground="#C0392B"
                    Text="■ 风险与使用建议（务必阅读）" />
                <TextBlock
                    Margin="0,5,0,0"
                    FontSize="13"
                    Foreground="#333333"
                    TextWrapping="Wrap"
                    Text="· 数据会被服务器记录：请以「轻度辅助」方式使用——跳过前置、任务省力、传送等；让积蓄自然增长，切勿大额刷钱或暴力刷级；&#10;· 关闭 BE 后进入的是「无 BE 匹配池」，遇到的多为同样关闭 BE 的玩家；&#10;· 建议使用小号或可承受损失的账号尝试；一切后果由使用者自行承担。" />

                <TextBlock
                    Margin="0,12,0,0"
                    FontSize="13.5"
                    FontWeight="Bold"
                    Foreground="#21A366"
                    Text="■ 我们提供的保障" />
                <TextBlock
                    Margin="0,5,0,0"
                    FontSize="13"
                    Foreground="#333333"
                    TextWrapping="Wrap"
                    Text="· FSL 已默认屏蔽遥测（BlockTelemetry），并定期自动备份存档；&#10;· 本工具在每次切换模式前会自动再打包一份存档备份（ProgramData\GTA5OnlineTools\Backups，保留最近 10 份，防手滑）；&#10;· 两种模式随时可一键切换，改回本地数据模式后，重新启动游戏即恢复本地存档。" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="1"
            Margin="16,10,16,14">
            <CheckBox
                x:Name="CheckBox_Agree"
                Checked="CheckBox_Agree_Changed"
                Content="我已阅读并知晓上述风险，自愿开启云端数据模式"
                FontSize="13"
                Unchecked="CheckBox_Agree_Changed" />
            <StackPanel
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    x:Name="Button_Cancel"
                    Padding="22,7"
                    Click="Button_Cancel_Click"
                    Content="取消" />
                <Button
                    x:Name="Button_Confirm"
                    Margin="10,0,0,0"
                    Padding="22,7"
                    Background="#FE780A"
                    Click="Button_Confirm_Click"
                    Content="确认切换为云端数据模式"
                    Foreground="White"
                    IsEnabled="False" />
            </StackPanel>
        </StackPanel>
    </Grid>

</ui:Window>
