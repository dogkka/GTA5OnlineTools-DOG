<ui:Window
    x:Class="GTA5OnlineTools.Windows.ContactWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://crazyzhang.cn/ui/2023/xaml"
    x:Name="Window_Contact"
    Title="联系 / 交流群 / 打赏 - DOG"
    Width="470"
    Height="650"
    ResizeMode="NoResize"
    Style="{StaticResource SystemWindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <ui:Window.TitleContent>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <Image
                Height="20"
                Margin="5"
                Source="/Assets/Favicon.ico"
                Style="{StaticResource ImageStyle_HighQuality}" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="Bold"
                Text="联系 / 交流群 / 打赏 - DOG" />
        </StackPanel>
    </ui:Window.TitleContent>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl
            x:Name="TabControl_Contact"
            Grid.Row="0"
            Margin="8,4,8,0"
            Background="Transparent"
            BorderThickness="0">
            <ui:TabItemIcon Header="作者微信" Icon="&#xe6e3;">
                <StackPanel>
                    <TextBlock
                        Margin="10,10,10,2"
                        HorizontalAlignment="Center"
                        FontSize="17"
                        FontWeight="Bold"
                        Text="扫码添加作者微信（DOG）" />
                    <Image
                        Width="360"
                        Height="390"
                        Margin="10,6"
                        HorizontalAlignment="Center"
                        Source="/Assets/contact_wechat.jpg"
                        Stretch="Uniform" />
                    <TextBlock
                        Margin="10,0,10,6"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="Gray"
                        Text="使用中遇到问题，扫码备注“小助手”即可" />
                </StackPanel>
            </ui:TabItemIcon>
            <ui:TabItemIcon Header="QQ 交流群" Icon="&#xe616;">
                <StackPanel>
                    <TextBlock
                        Margin="10,10,10,2"
                        HorizontalAlignment="Center"
                        FontSize="17"
                        FontWeight="Bold"
                        Text="QQ 交流群（仅提供群号）" />
                    <TextBlock
                        Margin="12,6,12,4"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="Gray"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Text="群进满速度很快，为减少爆满，程序内不再提供加群二维码；请用手机 QQ 搜索群号加入。" />

                    <Border
                        Margin="14,4,14,0"
                        Padding="12,10"
                        Background="#F7F8FA"
                        BorderBrush="#E1E4E8"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="15" FontWeight="Bold" Text="主群：472770575" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="#C0392B"
                                    Text="已满" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Padding="14,5"
                                Background="#12B7F5"
                                Foreground="White"
                                Tag="472770575"
                                Click="Button_CopyGroup_Click"
                                Content="复制" />
                        </Grid>
                    </Border>

                    <Border
                        Margin="14,8,14,0"
                        Padding="12,10"
                        Background="#F7F8FA"
                        BorderBrush="#E1E4E8"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="15" FontWeight="Bold" Text="备用1：1121769473" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="#C0392B"
                                    Text="已满" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Padding="14,5"
                                Background="#12B7F5"
                                Foreground="White"
                                Tag="1121769473"
                                Click="Button_CopyGroup_Click"
                                Content="复制" />
                        </Grid>
                    </Border>

                    <Border
                        Margin="14,8,14,0"
                        Padding="12,10"
                        Background="#F0FBF4"
                        BorderBrush="#BFE8CE"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="15" FontWeight="Bold" Text="备用2：1129626000" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="#21A366"
                                    Text="新群 · 推荐加入" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Padding="14,5"
                                Background="#21A366"
                                Foreground="White"
                                Tag="1129626000"
                                Click="Button_CopyGroup_Click"
                                Content="复制" />
                        </Grid>
                    </Border>

                    <TextBlock
                        Margin="14,10,14,0"
                        FontSize="12"
                        Foreground="Gray"
                        TextWrapping="Wrap"
                        Text="提示：已满的群无需反复尝试，直接加「备用2」群即可。" />
                </StackPanel>
            </ui:TabItemIcon>
            <ui:TabItemIcon Header="打赏支持" Icon="&#xe634;">
                <StackPanel>
                    <TextBlock
                        Margin="10,10,10,2"
                        HorizontalAlignment="Center"
                        FontSize="17"
                        FontWeight="Bold"
                        Text="请作者喝杯水，辛苦了" />
                    <TextBlock
                        Margin="10,0,10,2"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="Gray"
                        Text="自由金额 · 微信 / 支付宝均可" />
                    <UniformGrid Margin="6,6,6,0" Columns="2">
                        <StackPanel Margin="6,0,6,0">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="14"
                                FontWeight="Bold"
                                Text="微信打赏" />
                            <Image
                                Width="200"
                                Height="290"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                Source="/Assets/contact_reward_wechat.jpg"
                                Stretch="Uniform" />
                        </StackPanel>
                        <StackPanel Margin="6,0,6,0">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="14"
                                FontWeight="Bold"
                                Text="支付宝打赏" />
                            <Image
                                Width="200"
                                Height="290"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                Source="/Assets/contact_reward_alipay.jpg"
                                Stretch="Uniform" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock
                        Margin="10,10,10,6"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="Gray"
                        Text="个人开发不易，希望大家多多支持 · 完全自愿" />
                </StackPanel>
            </ui:TabItemIcon>
        </TabControl>

        <Button
            Grid.Row="1"
            Margin="0,4,0,10"
            Padding="24,6"
            HorizontalAlignment="Center"
            Background="#34A853"
            Click="Button_Close_Click"
            Content="关闭" />
    </Grid>

</ui:Window>
