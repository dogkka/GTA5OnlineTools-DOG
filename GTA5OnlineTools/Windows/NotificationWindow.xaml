<ui:Window
    x:Class="GTA5OnlineTools.Windows.NotificationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://crazyzhang.cn/ui/2023/xaml"
    x:Name="Window_Notification"
    Title="关于 / 支持作者  -  DOG"
    Width="680"
    Height="600"
    DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
    ResizeMode="NoResize"
    Style="{StaticResource SystemWindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <ui:Window.TitleContent>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <Image
                Height="20"
                Margin="5"
                Source="/Assets/Favicon.ico"
                Style="{StaticResource ImageStyle_HighQuality}" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="Bold"
                Text="关于 / 支持作者  -  DOG" />
        </StackPanel>
    </ui:Window.TitleContent>

    <Grid Margin="20,12,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock
                FontSize="19"
                FontWeight="Bold"
                Foreground="#1A1A1A"
                Text="感谢使用 · 支持作者" />
            <TextBlock
                Margin="0,8,0,0"
                FontSize="13.5"
                Foreground="#555555"
                TextWrapping="Wrap"
                Text="本项目完全免费开发与维护，不收取任何费用。为了让它能持续更新，作者也需要适当为自己的其他项目打一点广告，赚取一点微薄收入——感谢理解与支持！" />
        </StackPanel>

        <Border
            x:Name="Border_AdDogBot"
            Grid.Row="1"
            Margin="0,14,0,0"
            Padding="16,11"
            Cursor="Hand"
            MouseLeftButtonUp="Border_AdDogBot_MouseLeftButtonUp">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#F7FAF8" />
                    <Setter Property="BorderBrush" Value="#DCE6E1" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#EFF8F3" />
                            <Setter Property="BorderBrush" Value="#21A366" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#1A1A1A"
                        Text="可言AI" />
                    <TextBlock
                        Margin="0,3,0,0"
                        FontSize="12"
                        Foreground="#66756E"
                        Text="AI 接入微信 · 虚拟陪伴服务" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#21A366"
                    Text="点击访问 →" />
            </Grid>
        </Border>

        <Border
            x:Name="Border_AdAirport"
            Grid.Row="2"
            Margin="0,10,0,0"
            Padding="16,11"
            Cursor="Hand"
            MouseLeftButtonUp="Border_AdAirport_MouseLeftButtonUp">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#F7FAF8" />
                    <Setter Property="BorderBrush" Value="#DCE6E1" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#EFF8F3" />
                            <Setter Property="BorderBrush" Value="#21A366" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#1A1A1A"
                        Text="自研机场节点" />
                    <TextBlock
                        Margin="0,3,0,0"
                        FontSize="12"
                        Foreground="#66756E"
                        Text="专线高速 · 稳定可靠" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#21A366"
                    Text="点击访问 →" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock
                FontSize="13"
                FontWeight="Bold"
                Foreground="#C0392B"
                TextWrapping="Wrap"
                Text="温馨提示：本软件完全免费——遇到收费即是被骗，请务必联系卖软件给你的那个人退款。" />
            <TextBlock
                Margin="0,8,0,0"
                FontSize="12.5"
                Foreground="#777777"
                TextWrapping="Wrap"
                Text="更多内容（完整图文教程、常见问题、版本更新记录）可在主界面首页点击「打开使用教程」查看。" />
        </StackPanel>

        <Button
            x:Name="Button_Dismiss"
            Grid.Row="4"
            Height="42"
            Margin="0,14,0,0"
            Background="#21A366"
            BorderThickness="0"
            Click="Button_Dismiss_Click"
            Content="请稍候…"
            Cursor="Hand"
            FontSize="15"
            FontWeight="Bold"
            Foreground="White"
            IsEnabled="False" />
    </Grid>

</ui:Window>
