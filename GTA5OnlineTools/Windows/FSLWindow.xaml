<ui:Window
    x:Class="GTA5OnlineTools.Windows.FSLWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://crazyzhang.cn/ui/2023/xaml"
    x:Name="Window_OnlineLua"
    Title="GTA5线上小助手 - FSL管理"
    Width="1000"
    Height="550"
    DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
    Loaded="Window_FSL_Loaded"
    ResizeMode="CanMinimize"
    Style="{StaticResource SystemWindowStyle}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <ui:Window.TitleContent>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <Image
                Height="20"
                Margin="5"
                Source="/Assets/Favicon.ico"
                Style="{StaticResource ImageStyle_HighQuality}" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="Bold"
                Text="{Binding ElementName=Window_OnlineLua, Path=Title}" />
        </StackPanel>
    </ui:Window.TitleContent>

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="Normal" />
    </Window.TaskbarItemInfo>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>
        <!--  /////////// [DOG] 自动检测 / 一键处理 / 无BE启动  ///////////  -->
        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="5,6,5,0">
            <StackPanel Orientation="Horizontal">
            <TextBlock
                x:Name="TextBlock_Detected"
                Margin="4,0,16,0"
                VerticalAlignment="Center"
                FontWeight="Bold"
                Foreground="#21A366"
                Text="正在检测游戏安装…" />
            <Button
                x:Name="Button_AutoInstall"
                Margin="0,0,6,0"
                Background="#21A366"
                Click="Button_AutoInstall_Click"
                Content="一键安装FSL（自动检测）"
                Foreground="White" />
            <Button
                x:Name="Button_LaunchNoBE"
                Margin="0,0,6,0"
                Background="#FE780A"
                Click="Button_LaunchNoBE_Click"
                Content="无BE模式启动游戏（Epic适用）"
                Foreground="White" />
            <Button
                x:Name="Button_CreateShortcut"
                Click="Button_CreateShortcut_Click"
                Content="生成无BE桌面快捷方式" />
            </StackPanel>
            <TextBlock
                x:Name="TextBlock_FslStatus"
                Margin="4,4,10,0"
                FontSize="11.5"
                Foreground="#555555"
                TextWrapping="Wrap"
                Text="FSL 状态：检测中…" />
        </StackPanel>
        <!--  //////////////////////  -->
        <StackPanel
            Grid.Row="1"
            Grid.Column="0"
            Margin="5"
            Orientation="Horizontal">

            <!--  ////////////////  -->
            <StackPanel Orientation="Horizontal">
                <Button
                    x:Name="Button_GTA_STEAM_Dir"
                    Background="#FE780A"
                    Click="Button_GTA_STEAM_Dir_Click"
                    Content="GTAV目录-Steam" />
                <Button
                    x:Name="Button_GTA_EPIC_Dir"
                    Background="#FE780A"
                    Click="Button_GTA_EPIC_Dir_Click"
                    Content="GTAV目录-epic" />
                <Button
                x:Name="Button_StartDownload_Steam"
                Click="Button_StartDownload_Steam_Click"
                Content="安装FSL-Steam" />
                <Button
                x:Name="Button_StartDownload_Epic"
                Click="Button_StartDownload_Epic_Click"
                Content="安装FSL-Epic" />
                <Button
                    x:Name="Button_RM_FSL_Steam"
                    Click="Button_RM_FSL_Steam_Click"
                    Content="移除FSL-Steam" />
                <Button
                    x:Name="Button_RM_FSL_Epic"
                    Click="Button_RM_FSL_Epic_Click"
                    Content="移除FSL-Epic" />
                <Button
                    x:Name="Button_FSL_Dir"
                    Background="#FE780A"
                    Click="Button_FSL_Dir_Click"
                    Content="FSL存档目录" />
            </StackPanel>
        </StackPanel>
        <!--  //////////////////////  -->
        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            Margin="5"
            HorizontalAlignment="Right"
            Orientation="Horizontal">

        </StackPanel>
        <!--  /////////// [DOG] 存档模式（本地数据 / 官方数据）  ///////////  -->
        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            Grid.RowSpan="2"
            Margin="5,0,8,5">
            <TextBlock
                FontSize="15"
                FontWeight="Bold"
                Text="存档模式（数据去向）" />
            <TextBlock
                Margin="0,4,0,0"
                FontSize="11.5"
                Foreground="Gray"
                TextWrapping="Wrap"
                Text="两种模式任选其一（传承版 / 增强版通用）；切换后需重启游戏生效。适合自己玩法的才是好模式。" />
            <Button
                x:Name="Button_SaveMode_Local"
                Margin="0,10,0,0"
                Background="#21A366"
                Click="Button_SaveMode_Local_Click"
                Content="切换为：本地数据模式"
                Foreground="White" />
            <TextBlock
                Margin="0,4,0,0"
                FontSize="11"
                Foreground="#555555"
                TextWrapping="Wrap"
                Text="存档存本地（%appdata%\FSL），不上传官方服务器；可放心刷钱 / 解锁，娱乐向首选。换机或重装前务必备份。" />
            <Button
                x:Name="Button_SaveMode_Cloud"
                Margin="0,10,0,0"
                Background="#FE780A"
                Click="Button_SaveMode_Cloud_Click"
                Content="切换为：云端数据模式"
                Foreground="White" />
            <TextBlock
                Margin="0,4,0,0"
                FontSize="11"
                Foreground="#555555"
                TextWrapping="Wrap"
                Text="存档照常上传官方服务器（云同步）；无 BE 进线上。建议轻度辅助、任务为主、慢慢积累——数据可见于服务器，请自行把握节奏。" />
            <TextBlock
                x:Name="TextBlock_CurrentSaveMode"
                Margin="0,12,0,0"
                FontSize="12"
                FontWeight="Bold"
                Foreground="#21A366"
                TextWrapping="Wrap"
                Text="当前模式：检测中…" />
            <Button
                x:Name="Button_BackupSaves"
                Margin="0,12,0,0"
                Background="#FE780A"
                Click="Button_BackupSaves_Click"
                Content="备份FSL存档"
                Foreground="White" />
            <TextBlock
                Margin="0,4,0,0"
                FontSize="11"
                Foreground="#555555"
                TextWrapping="Wrap"
                Text="手动打包一份 %appdata%\FSL（存档 + 配置）到 ProgramData\GTA5OnlineTools\Backups（保留最近 10 份）。换机 / 重装 / 更新 FSL 前建议先点一次。" />
        </StackPanel>
        <!--  //////////////////////  -->
        <DockPanel Grid.Row="2" Grid.Column="0">
            <Grid DockPanel.Dock="Bottom">
                <ProgressBar
                    Name="ProgressBar_Download"
                    Height="35"
                    Margin="5"
                    VerticalAlignment="Center"
                    Background="White"
                    BorderBrush="#ABADB3"
                    Maximum="1024"
                    Minimum="0"
                    SmallChange="1" />
                <TextBlock
                    Name="TextBlock_Percentage"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="0KB / 0MB" />
            </Grid>
            <!--  ///////////  -->
            <Grid Margin="0,0,5,5">
                <TextBox
                    x:Name="TextBox_Logger"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Style="{StaticResource TextBoxStyle_Logger}" />
            </Grid>
        </DockPanel>
        <!--  //////////////////////  -->

    </Grid>

</ui:Window>
