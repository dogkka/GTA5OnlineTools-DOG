<ui:Window
    x:Class="GTA5OnlineTools.Windows.HealthCheckWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://crazyzhang.cn/ui/2023/xaml"
    x:Name="Window_HealthCheck"
    Title="环境自检 - DOG"
    Width="640"
    Height="680"
    ResizeMode="NoResize"
    Style="{StaticResource SystemWindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <ui:Window.TitleContent>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <Image
                Height="20"
                Margin="5"
                Source="/Assets/Favicon.ico"
                Style="{StaticResource ImageStyle_HighQuality}" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="Bold"
                Text="环境自检 - DOG" />
        </StackPanel>
    </ui:Window.TitleContent>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            Margin="16,12,16,0"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock
                    FontSize="13"
                    Foreground="#666666"
                    TextWrapping="Wrap"
                    Text="一键检查：运行环境 / 游戏安装 / FSL / 菜单文件与版本 / 玩法脚本 / 数据模式 / 呼出键 等；顶部直接给出「能否进游戏注入」结论。只读检查（仅目录探针会临时建删）；结果可复制发群求助。" />
                <StackPanel
                    x:Name="Panel_Items"
                    Margin="0,10,0,0" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="1"
            Margin="16,10,16,14">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    x:Name="Button_Recheck"
                    Padding="18,7"
                    Click="Button_Recheck_Click"
                    Content="重新检查" />
                <Button
                    x:Name="Button_Copy"
                    Padding="18,7"
                    Click="Button_Copy_Click"
                    Content="复制结果" />
                <Button
                    x:Name="Button_Bundle"
                    Padding="18,7"
                    Click="Button_Bundle_Click"
                    Content="生成反馈包" />
                <Button
                    x:Name="Button_Close"
                    Padding="22,7"
                    Click="Button_Close_Click"
                    Content="关闭" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:Window>
