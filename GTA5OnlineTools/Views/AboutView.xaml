<UserControl
    x:Class="GTA5OnlineTools.Views.AboutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="620"
    d:DesignWidth="1100"
    DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
    Style="{StaticResource UserControlStyle_Loaded}"
    mc:Ignorable="d">

    <StackPanel Margin="5">
        <Image
            Width="96"
            Height="96"
            Margin="10"
            Source="/Assets/Favicon.ico" />

        <TextBlock
            Margin="5,0,5,5"
            HorizontalAlignment="Center"
            FontSize="30"
            FontWeight="Bold"
            Text="GTA5 线上小助手 · DOG 二次开发版" />

        <TextBlock
            Margin="5"
            HorizontalAlignment="Center"
            FontSize="15"
            Text="本程序继承自原作者 CrazyZhang 的开源项目，并进行了二次开发" />

        <TextBlock
            Margin="5"
            HorizontalAlignment="Center"
            FontSize="15">
            原作者项目（CrazyZhang）：
            <Hyperlink NavigateUri="https://github.com/CrazyZhang666/GTA5OnlineTools" RequestNavigate="Hyperlink_RequestNavigate">https://github.com/CrazyZhang666/GTA5OnlineTools</Hyperlink>
        </TextBlock>

        <TextBlock
            Margin="5"
            HorizontalAlignment="Center"
            FontSize="15">
            上游基础仓库（sch 分支，MIT）：
            <Hyperlink NavigateUri="https://github.com/sch-lda/GTA5OnlineTools" RequestNavigate="Hyperlink_RequestNavigate">https://github.com/sch-lda/GTA5OnlineTools</Hyperlink>
        </TextBlock>

        <TextBlock
            Margin="5"
            HorizontalAlignment="Center"
            FontSize="15">
            本二改仓库（DOG）：
            <Hyperlink NavigateUri="https://github.com/dogkka/GTA5OnlineTools-DOG" RequestNavigate="Hyperlink_RequestNavigate">https://github.com/dogkka/GTA5OnlineTools-DOG</Hyperlink>
        </TextBlock>

        <TextBlock
            Margin="5,10,5,5"
            HorizontalAlignment="Center"
            FontSize="26"
            FontWeight="Bold"
            Text="DOG" />

        <TextBlock
            Margin="5"
            HorizontalAlignment="Center"
            FontSize="14"
            Foreground="Gray"
            Text="已内置中文 YimMenuV2、传承版维护版菜单 DLL 与 FSL V6 · 不访问任何第三方服务器" />

        <TextBlock
            Margin="5,6,5,0"
            HorizontalAlignment="Center"
            FontSize="14"
            FontWeight="Bold"
            Foreground="#C0392B"
            Text="公益免费软件：遇到收费即是被骗，请务必联系卖家退款" />

        <TextBlock
            Margin="5,6,5,0"
            HorizontalAlignment="Center"
            FontSize="14"
            Text="QQ 交流群：1121769473（二维码见顶部「联系」按钮）" />
        <TextBlock
            Margin="5,6,5,0"
            HorizontalAlignment="Center"
            FontSize="14"
            Text="打赏支持：完全自愿，不影响免费使用（见顶部「打赏」按钮）" />

        <TextBlock
            x:Name="TextBlock_AboutVersion"
            Margin="5,8,5,0"
            HorizontalAlignment="Center"
            FontSize="14"
            Foreground="Gray"
            Text="当前版本：" />

        <StackPanel
            Margin="0,16,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Button
                Padding="18,6"
                Background="#34A853"
                Click="Button_About_Click"
                Content="查看使用说明 / 教程" />
            <Button
                x:Name="Button_AboutCheckUpdate"
                Margin="10,0,0,0"
                Padding="18,6"
                Click="Button_CheckUpdate_Click"
                Content="检查更新" />
            <Button
                x:Name="Button_Uninstall"
                Margin="10,0,0,0"
                Padding="18,6"
                Background="#C0392B"
                Foreground="White"
                Click="Button_Uninstall_Click"
                Content="一键卸载（清理配置与缓存）" />
        </StackPanel>
    </StackPanel>

</UserControl>
