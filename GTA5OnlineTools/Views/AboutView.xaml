<UserControl
    x:Class="GTA5OnlineTools.Views.AboutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="620"
    d:DesignWidth="1100"
    DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
    Style="{StaticResource UserControlStyle_Loaded}"
    mc:Ignorable="d">

    <StackPanel Margin="5">
        <Image
            Width="96"
            Height="96"
            Margin="10"
            Source="/Assets/Favicon.ico" />

        <TextBlock
            Margin="5,0,5,5"
            HorizontalAlignment="Center"
            FontSize="30"
            FontWeight="Bold"
            Text="GTA5 线上小助手 · DOG 二次开发版" />

        <TextBlock
            Margin="5"
            HorizontalAlignment="Center"
            FontSize="15"
            Text="本程序继承自原作者 CrazyZhang 的开源项目，并进行了二次开发" />

        <TextBlock
            Margin="5"
            HorizontalAlignment="Center"
            FontSize="15">
            原作者项目（CrazyZhang）：
            <Hyperlink NavigateUri="https://github.com/CrazyZhang666/GTA5OnlineTools" RequestNavigate="Hyperlink_RequestNavigate">https://github.com/CrazyZhang666/GTA5OnlineTools</Hyperlink>
        </TextBlock>

        <TextBlock
            Margin="5"
            HorizontalAlignment="Center"
            FontSize="15">
            上游基础仓库（sch 分支，MIT）：
            <Hyperlink NavigateUri="https://github.com/sch-lda/GTA5OnlineTools" RequestNavigate="Hyperlink_RequestNavigate">https://github.com/sch-lda/GTA5OnlineTools</Hyperlink>
        </TextBlock>

        <TextBlock
            Margin="5"
            HorizontalAlignment="Center"
            FontSize="15">
            本二改仓库（DOG）：
            <Hyperlink NavigateUri="https://github.com/dogkka/GTA5OnlineTools-DOG" RequestNavigate="Hyperlink_RequestNavigate">https://github.com/dogkka/GTA5OnlineTools-DOG</Hyperlink>
        </TextBlock>

        <TextBlock
            Margin="5,10,5,5"
            HorizontalAlignment="Center"
            FontSize="26"
            FontWeight="Bold"
            Text="DOG" />

        <TextBlock
            Margin="5"
            HorizontalAlignment="Center"
            FontSize="14"
            Foreground="Gray"
            Text="已内置中文 YimMenuV2 菜单 DLL 与 FSL V6 · 完全离线（不访问第三方服务器）" />

        <Button
            Margin="0,18,0,0"
            Padding="18,6"
            HorizontalAlignment="Center"
            Background="#34A853"
            Click="Button_About_Click"
            Content="查看使用说明 / 教程" />
    </StackPanel>

</UserControl>
