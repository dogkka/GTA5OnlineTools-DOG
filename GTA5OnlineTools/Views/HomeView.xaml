<UserControl
    x:Class="GTA5OnlineTools.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://crazyzhang.cn/ui/2023/xaml"
    d:DesignHeight="620"
    d:DesignWidth="1100"
    DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
    Style="{StaticResource UserControlStyle_Loaded}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <RichTextBox Grid.Row="0" Margin="5,5,2.5,5" Style="{StaticResource RichTextBoxStyle_ReadMe}">
            <FlowDocument>

                <Paragraph Style="{StaticResource ParagraphStyle_Title}" FontSize="19">
                    软件介绍
                </Paragraph>
                <Paragraph Style="{StaticResource ParagraphStyle_Content}" FontSize="15">
                    本程序是《GTA5 线上小助手》的离线二次开发版（作者：<Run FontWeight="Bold">DOG</Run>）。
                    内置自编译的简体中文 YimMenuV2 菜单 DLL 与 FSL V6：可以一键安装 FSL、一键注入中文菜单，
                    并提供配置目录、日志查看、脚本目录等常用工具。
                    本版本<Run FontWeight="Bold">已移除原版的公告服务器与云端校验</Run>，不会从任何第三方服务器下载文件。
                </Paragraph>
                <Paragraph Style="{StaticResource ParagraphStyle_Content}" FontSize="15" Foreground="#C0392B" FontWeight="Bold">
                    本软件完全免费：遇到收费即是被骗，请务必联系卖家退款。官方发布渠道只有本二改仓库的 GitHub 页面。
                </Paragraph>

                <Paragraph Style="{StaticResource ParagraphStyle_Title}" FontSize="19">
                    版本说明
                </Paragraph>
                <Paragraph Style="{StaticResource ParagraphStyle_Content}" FontSize="15">
                    本程序目前<Run FontWeight="Bold" Foreground="#C0392B">只维护 GTA5 增强版（Enhanced）</Run>；
                    传统版（Legacy）已失去维护，原作者也已明确说明停止对传统版的更新——
                    请使用<Run FontWeight="Bold">增强版</Run>游戏配合本程序。
                </Paragraph>

                <Paragraph Style="{StaticResource ParagraphStyle_Title}" FontSize="19">
                    使用教程
                </Paragraph>
                <Paragraph Style="{StaticResource ParagraphStyle_Content}" FontSize="15">
                    完整的图文教程（安装步骤 · 全功能说明 · 常见问题 · 版本更新记录）已整理为独立页面，
                    点击下方按钮即可打开（支持浅色 / 深色模式）：
                </Paragraph>

            </FlowDocument>
        </RichTextBox>

        <Border
            x:Name="Border_OpenTutorial"
            Grid.Row="1"
            Height="58"
            Margin="10,0,12.5,10"
            Cursor="Hand"
            MouseLeftButtonUp="Border_OpenTutorial_MouseLeftButtonUp">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#21A366" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2AB573" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="17"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="打开使用教程" />
                <TextBlock
                    Margin="0,2,0,0"
                    HorizontalAlignment="Center"
                    FontSize="11"
                    Foreground="#EAFFF4"
                    Text="图文教程 · 全功能说明 · 常见问题 · 支持浅色 / 深色模式" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
