<UserControl
    x:Class="GTA5OnlineTools.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://crazyzhang.cn/ui/2023/xaml"
    d:DesignHeight="620"
    d:DesignWidth="1100"
    DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
    Style="{StaticResource UserControlStyle_Loaded}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />        </Grid.RowDefinitions>

        <RichTextBox Grid.Row="0" Margin="5,5,2.5,5" Style="{StaticResource RichTextBoxStyle_ReadMe}">
            <FlowDocument>

                <Paragraph Style="{StaticResource ParagraphStyle_Title}" FontSize="19">
                    软件介绍
                </Paragraph>
                <Paragraph Style="{StaticResource ParagraphStyle_Content}" FontSize="15">
                    本程序是《GTA5 线上小助手》的离线二次开发版（作者：<Run FontWeight="Bold">DOG</Run>）。
                    内置自编译的简体中文 YimMenuV2 菜单、传承版社区维护版菜单与 FSL V6：可以一键安装 FSL、一键注入中文菜单，
                    并提供配置目录、日志查看、脚本目录等常用工具。
                    本版本<Run FontWeight="Bold">已移除原版的公告服务器与云端校验</Run>，不会从任何第三方服务器下载文件。
                </Paragraph>
                <Paragraph Style="{StaticResource ParagraphStyle_Content}" FontSize="15" Foreground="#C0392B" FontWeight="Bold">
                    本软件完全免费：遇到收费即是被骗，请务必联系卖家退款。官方发布渠道只有本二改仓库的 GitHub 页面。
                </Paragraph>

                <Paragraph Style="{StaticResource ParagraphStyle_Title}" FontSize="19">
                    版本说明
                </Paragraph>
                <Paragraph Style="{StaticResource ParagraphStyle_Content}" FontSize="15">
                    本程序同时支持两条线：<Run FontWeight="Bold">增强版（Enhanced）</Run>内置自编译中文 YimMenuV2；
                    <Run FontWeight="Bold">传承版（Legacy）</Run>内置社区维护版 YimMenu（适配传承版 1.73 b3889）。
                    游戏大版本更新后菜单可能暂时失效，需等待维护线跟进适配。
                </Paragraph>

                <Paragraph Style="{StaticResource ParagraphStyle_Title}" FontSize="19">
                    使用教程
                </Paragraph>
                <Paragraph Style="{StaticResource ParagraphStyle_Content}" FontSize="15">
                    完整的图文教程（安装步骤 · 全功能说明 · 常见问题 · 版本更新记录）已整理为独立页面，
                    点击下方按钮即可打开（支持浅色 / 深色模式）：
                </Paragraph>

            </FlowDocument>
        </RichTextBox>

        <!--  [DOG] 数据模式（本地数据 / 云端数据）  -->
        <Border
            Grid.Row="1"
            Margin="10,0,12.5,10"
            Padding="12,10,12,12"
            Background="#F7F8FA"
            BorderBrush="#E1E4E8"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel>
                <Grid>
                    <TextBlock
                        FontSize="15"
                        FontWeight="Bold"
                        Text="数据模式（存档去向）" />
                    <TextBlock
                        x:Name="TextBlock_ModeStatus"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="#808A93"
                        Text="当前：检测中…" />
                </Grid>
                <TextBlock
                    x:Name="TextBlock_ModeDesc"
                    Margin="0,4,0,0"
                    FontSize="11.5"
                    Foreground="#6B7680"
                    TextWrapping="Wrap"
                    Text="「本地数据 / 云端数据」对传承版与增强版均适用：两种模式都在「关闭 BattlEye + FSL」下进入线上，区别只有存档去向；切换后需重启游戏生效。" />
                <Grid Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="Card_ModeLocal"
                        Grid.Column="0"
                        Padding="12,10"
                        Cursor="Hand"
                        MouseLeftButtonUp="Card_ModeLocal_MouseLeftButtonUp">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="White" />
                                <Setter Property="BorderBrush" Value="#D5DAE0" />
                                <Setter Property="BorderThickness" Value="1.5" />
                                <Setter Property="CornerRadius" Value="8" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.85" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="#21A366"
                                Text="① 本地数据模式" />
                            <TextBlock
                                Margin="0,5,0,0"
                                FontSize="11.5"
                                Foreground="#4A555F"
                                TextWrapping="Wrap"
                                Text="存档只存本机（%appdata%\FSL），不上传服务器；可放开刷钱 / 解锁，娱乐向首选。换机或重装前务必备份。" />
                            <TextBlock
                                x:Name="Badge_ModeLocal"
                                Margin="0,7,0,0"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="#21A366"
                                Text="" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="Card_ModeCloud"
                        Grid.Column="2"
                        Padding="12,10"
                        Cursor="Hand"
                        MouseLeftButtonUp="Card_ModeCloud_MouseLeftButtonUp">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="White" />
                                <Setter Property="BorderBrush" Value="#D5DAE0" />
                                <Setter Property="BorderThickness" Value="1.5" />
                                <Setter Property="CornerRadius" Value="8" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.85" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="#FE780A"
                                Text="② 云端数据模式" />
                            <TextBlock
                                Margin="0,5,0,0"
                                FontSize="11.5"
                                Foreground="#4A555F"
                                TextWrapping="Wrap"
                                Text="存档照常上传官方服务器（云同步）；适合轻度辅助、任务省力、慢慢积累。开启前需阅读使用须知。" />
                            <TextBlock
                                x:Name="Badge_ModeCloud"
                                Margin="0,7,0,0"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="#FE780A"
                                Text="" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

                <!--  [DOG] 底部快捷入口：教程 / 自检 / 打赏（横向三按钮，2026-10-11 紧凑化原三张通栏大卡）  -->
        <Grid
            Grid.Row="2"
            Height="46"
            Margin="10,0,12.5,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="10" />
                <ColumnDefinition />
                <ColumnDefinition Width="10" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="Border_OpenTutorial"
                Grid.Column="0"
                Cursor="Hand"
                MouseLeftButtonUp="Border_OpenTutorial_MouseLeftButtonUp"
                ToolTip="图文教程 · 全功能说明 · 常见问题 · 支持浅色 / 深色模式">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#21A366" />
                        <Setter Property="CornerRadius" Value="6" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2AB573" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="使用教程" />
            </Border>

            <Border
                x:Name="Border_HealthCheck"
                Grid.Column="2"
                Cursor="Hand"
                MouseLeftButtonUp="Border_HealthCheck_MouseLeftButtonUp"
                ToolTip="游戏 / FSL / 脚本 / 数据模式 / 呼出键 全检查 · 结果可复制发群">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#3E7BFA" />
                        <Setter Property="CornerRadius" Value="6" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5C90FF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="环境自检" />
            </Border>

            <Border
                x:Name="Border_Reward"
                Grid.Column="4"
                Cursor="Hand"
                MouseLeftButtonUp="Border_Reward_MouseLeftButtonUp"
                ToolTip="个人开发不易 · 完全自愿，不影响免费使用">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F0761C" />
                        <Setter Property="CornerRadius" Value="6" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FD8A36" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="打赏支持" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
